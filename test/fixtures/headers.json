{
  "_": "Header-only fixtures. Each case lists column names a file might arrive with and the mapping they must produce. Platform cases carry the vendor documentation the names were read from in source_url. Salesforce has no case: its docs could not be read, and names were not written from memory. See column_name_sources in rules.yaml.",
  "cases": {
    "awkward": {
      "_": "Deliberately awkward names: punctuation, units, casing, trailing colons, dotted paths. Not any vendor's export.",
      "headers": [
        "Ticket ID #",
        "CREATED (UTC)",
        "Closed_On",
        "ticket.status",
        "Assigned To:",
        "Cust. Wait (mins)"
      ],
      "expect": {
        "case_id": "Ticket ID #",
        "created_at": "CREATED (UTC)",
        "closed_at": "Closed_On",
        "status": "ticket.status",
        "owner": "Assigned To:",
        "wait_time": "Cust. Wait (mins)"
      }
    },
    "camel_case": {
      "_": "camelCase API names, which the old exact matcher missed almost entirely.",
      "headers": [
        "caseId",
        "createdAt",
        "closedAt",
        "status",
        "assigneeId",
        "groupId",
        "satisfactionRating"
      ],
      "expect": {
        "case_id": "caseId",
        "created_at": "createdAt",
        "closed_at": "closedAt",
        "status": "status",
        "owner": "assigneeId",
        "group": "groupId",
        "csat_score": "satisfactionRating"
      }
    },
    "zendesk": {
      "_": "Field names read from the page at source_url.",
      "source_url": "https://developer.zendesk.com/api-reference/ticketing/tickets/tickets/",
      "headers": [
        "id",
        "subject",
        "description",
        "status",
        "priority",
        "created_at",
        "updated_at",
        "assignee_id",
        "group_id",
        "organization_id",
        "satisfaction_rating",
        "via"
      ],
      "expect": {
        "case_id": "id",
        "subject": "subject",
        "description": "description",
        "status": "status",
        "priority": "priority",
        "created_at": "created_at",
        "last_update_at": "updated_at",
        "owner": "assignee_id",
        "group": "group_id",
        "account_id": "organization_id",
        "csat_score": "satisfaction_rating",
        "channel": "via"
      }
    },
    "freshdesk": {
      "_": "Field names read from the page at source_url.",
      "source_url": "https://developers.freshdesk.com/api/",
      "headers": [
        "id",
        "subject",
        "description_text",
        "status",
        "priority",
        "created_at",
        "updated_at",
        "responder_id",
        "group_id",
        "company_id",
        "source",
        "is_escalated"
      ],
      "expect": {
        "case_id": "id",
        "subject": "subject",
        "description": "description_text",
        "status": "status",
        "priority": "priority",
        "created_at": "created_at",
        "last_update_at": "updated_at",
        "owner": "responder_id",
        "group": "group_id",
        "account_id": "company_id",
        "channel": "source",
        "escalated": "is_escalated"
      }
    },
    "intercom": {
      "_": "Field names read from the page at source_url.",
      "source_url": "https://developers.intercom.com/docs/references/rest-api/api.intercom.io/conversations/conversation",
      "headers": [
        "id",
        "title",
        "created_at",
        "updated_at",
        "state",
        "priority",
        "admin_assignee_id",
        "team_assignee_id",
        "conversation_rating",
        "channel"
      ],
      "expect": {
        "case_id": "id",
        "subject": "title",
        "created_at": "created_at",
        "last_update_at": "updated_at",
        "status": "state",
        "priority": "priority",
        "owner": "admin_assignee_id",
        "group": "team_assignee_id",
        "csat_score": "conversation_rating",
        "channel": "channel"
      }
    },
    "hubspot": {
      "_": "Field names read from the page at source_url.",
      "source_url": "https://developers.hubspot.com/docs/api-reference/legacy/crm/objects/tickets/guide",
      "headers": [
        "hs_object_id",
        "subject",
        "content",
        "hs_pipeline_stage",
        "hs_ticket_priority",
        "hs_ticket_category"
      ],
      "expect": {
        "case_id": "hs_object_id",
        "subject": "subject",
        "description": "content",
        "status": "hs_pipeline_stage",
        "priority": "hs_ticket_priority",
        "reason": "hs_ticket_category"
      }
    },
    "jira_service_management": {
      "_": "Field names read from the page at source_url.",
      "source_url": "https://developer.atlassian.com/cloud/jira/platform/jira-expressions-type-reference/",
      "headers": [
        "key",
        "summary",
        "description",
        "status",
        "created",
        "updated",
        "resolutiondate",
        "assignee",
        "priority"
      ],
      "expect": {
        "case_id": "key",
        "subject": "summary",
        "description": "description",
        "status": "status",
        "created_at": "created",
        "last_update_at": "updated",
        "closed_at": "resolutiondate",
        "owner": "assignee",
        "priority": "priority"
      }
    }
  }
}
